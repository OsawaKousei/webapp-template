# frontend/Dockerfile
FROM node:22-slim

# pnpm の有効化
RUN corepack enable && corepack prepare pnpm@latest --activate
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# nodeユーザーで依存を扱えるように事前作成
RUN mkdir -p /app/app/.deps/store && chown -R node:node /app

WORKDIR /app/app

# ホスト側にroot所有ファイルを作らないため、nodeユーザーで実行
USER node

# 起動コマンド (インストール後に dev サーバーを立ち上げる)
CMD ["sh", "-c", "set -e; mkdir -p .deps/node_modules .deps/store; if [ -e node_modules ] || [ -L node_modules ]; then if [ -L node_modules ] && [ \"$(readlink node_modules)\" = \".deps/node_modules\" ]; then :; else rm -rf node_modules; ln -s .deps/node_modules node_modules; fi; else ln -s .deps/node_modules node_modules; fi; pnpm install --config.confirmModulesPurge=false && pnpm dev"]